# Copyright (c) 2018 Sony Mobile Communications Inc.
#
# adux1050 specific configuration
#

on early-init
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules/ \
        adux1050
on init
    # slave address: 0x2c
    chmod 220 /sys/bus/i2c/devices/3-002c/adux1050_offset_dac_write
    chmod 660 /sys/bus/i2c/devices/3-002c/adux1050_enable
    chown system system /sys/bus/i2c/devices/3-002c/adux1050_offset_dac_write
    chown system system /sys/bus/i2c/devices/3-002c/adux1050_enable

    # slave address: 0x2d
    chmod 220 /sys/bus/i2c/devices/3-002d/adux1050_offset_dac_write
    chmod 660 /sys/bus/i2c/devices/3-002d/adux1050_enable
    chown system system /sys/bus/i2c/devices/3-002d/adux1050_offset_dac_write
    chown system system /sys/bus/i2c/devices/3-002d/adux1050_enable

    # slave address: 0x2e
    chmod 220 /sys/bus/i2c/devices/3-002e/adux1050_offset_dac_write
    chmod 660 /sys/bus/i2c/devices/3-002e/adux1050_enable
    chown system system /sys/bus/i2c/devices/3-002e/adux1050_offset_dac_write
    chown system system /sys/bus/i2c/devices/3-002e/adux1050_enable
